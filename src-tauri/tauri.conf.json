{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CX Timeline",
  "version": "1.0.0",
  "identifier": "com.khouryai.cxtimeline",
  "build": {
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "CX Timeline",
        "width": 1500,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://cx-timeline.aik-khoury.workers.dev; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
