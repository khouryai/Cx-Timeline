{
  "name": "cx-timeline",
  "version": "1.0.0",
  "description": "CX Timeline — hosted interactive timeline & commissioning planner",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "watch": "node tools/build.js --watch",
    "test": "node tools/smoke.js && node tools/smoke_folder.js && node tools/smoke_hosted.js && node tools/test_sql.js",
    "serve": "node tools/serve.js",
    "test:sql": "node tools/test_sql.js",
    "test:smoke": "node tools/smoke.js",
    "test:folder": "node tools/smoke_folder.js",
    "test:hosted": "node tools/smoke_hosted.js",
    "build:dist": "node tools/build.js && node tools/dist.js",
    "build:folder": "node tools/build.js && node tools/dist.js --no-backend"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
