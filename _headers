# Cloudflare Pages response headers.
#
# The application loads nothing at runtime except its own files and the
# Supabase API, so the policy can be tight enough to be worth having.
#
# `connect-src` has to allow the project's own host. Cloudflare Pages does not
# expand build variables here, so if you fork this for a different project,
# change the two supabase.co entries below to match — or widen them to
# https://*.supabase.co, which is what they already are.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

# The bundles are rebuilt on every deploy and their names never change, so they
# must not be cached across deploys or people keep running the previous version.
# (tools/dist.js renames them after their contents and replaces this rule.)
/app.bundle.js
  Cache-Control: no-cache

/mobile.bundle.js
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/phone.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The phone app (published in the calendar shape only). The page, the manifest
# and the service worker are never cached by HTTP: the worker must see a new
# deploy on the next open, and a browser checks a worker script for updates
# against exactly this. What the worker itself keeps is the app, never the data.
/m/
  Cache-Control: no-cache

/m/index.html
  Cache-Control: no-cache

/m/sw.js
  Cache-Control: no-cache

/m/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# The vendored client is pinned, so it can be cached hard.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The update channel the installed desktop application follows.
#
# `Access-Control-Allow-Origin` is required and is not a widening of anything:
# these two files are the application's own code and stylesheets, already served
# to anyone who opens the site. The header only lets the desktop shell — which
# runs on its own local origin — read what a browser tab may already read. It is
# scoped to this path so nothing else on the site becomes cross-origin readable.
#
# Never cached: the whole point is that a launch sees the version just deployed.
/desktop/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
